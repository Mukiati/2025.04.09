<Window x:Class="_2025._04._09.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2025._04._09"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label Content="Palacsinta rendelés" Grid.Column="1" VerticalContentAlignment="Center"/>
        <TextBox Text="Palacxsinta darabszám" Grid.Row="1" Margin="10" Background="LawnGreen" Foreground="Black" Name="dbinput" Tag="Palacxsinta darabszám"/>
        <TextBox Text="Tészta típusa" Grid.Row="2" Margin="10" Background="LightSeaGreen" Foreground="White" Name="pastainput" Tag="Tészta típusa"/>
        <TextBox Text="Töltelék típusa" Grid.Row="3" Margin="10" Background="DarkGreen" Foreground="White"  Name="filigninput"  Tag="Töltelék típusa"/>
        <Button Content="Hozuzáadás" Margin="20" Grid.Row="4" Name="addbutton"/>
        <Button Content="Mégse" Margin="20" Grid.Row="5" Name="cancelbutton"/>
        <Button Content="Rendelés" Margin="20" Grid.Row="5" Grid.Column="2" Name="order"/>
        <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.RowSpan="3">
            <StackPanel Grid.Column="2" Background="LawnGreen"  Grid.Row="1" Grid.RowSpan="3" Orientation="Vertical" Name="all"/>
        </ScrollViewer>

        <Label Content="Összesen : " VerticalContentAlignment="Center" Grid.Row="3" Name="allprice" Background="Yellow" Margin="0,20,20,0" Grid.Column="1"/>



    </Grid>
</Window>
